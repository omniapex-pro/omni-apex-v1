{
  "name": "omni-apex-v1",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "build": "remix build",
    "dev": "remix dev --manual",
    "generate": "prisma generate",
    "lint": "eslint --ignore-path .gitignore --cache --cache-location ./node_modules/.cache/eslint .",
    "start": "prisma db push --accept-data-loss && remix-serve ./build/index.js",
    "typecheck": "tsc",
    "migrate": "prisma db push --accept-data-loss",
    "setup": "npm run generate && npm run migrate",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "5.17.0",
    "@remix-run/node": "2.6.0",
    "@remix-run/react": "2.6.0",
    "@remix-run/serve": "2.6.0",
    "@shopify/app-bridge-react": "4.1.2",
    "@shopify/polaris": "12.7.0",
    "@shopify/shopify-api": "9.7.2",
    "@shopify/shopify-app-remix": "2.7.0",
    "@shopify/shopify-app-session-storage-prisma": "4.0.5",
    "isbot": "4.4.0",
    "prisma": "5.17.0",
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "devDependencies": {
    "@remix-run/dev": "2.6.0",
    "@remix-run/eslint-config": "2.6.0",
    "@shopify/app-bridge-types": "^0.0.3",
    "@types/react": "^18.2.42",
    "@types/react-dom": "^18.2.17",
    "eslint": "^8.42.0",
    "typescript": "^5.2.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
